APP_NAME=doc-ocr
DEBUG=false
API_PREFIX=/api/v1
# Tailscale / LAN — Swagger + API (self-hosted /docs, CORS *)
API_CORS_ORIGINS=*
# Optional: behind reverse proxy, e.g. API_ROOT_PATH=/ocr
API_ROOT_PATH=
# Optional fixed OpenAPI server URL, e.g. http://100.x.x.x:8000
API_PUBLIC_URL=

# ── Engine routing ────────────────────────────────────────────────────────────
#   smart     → RapidOCR (~0.25 s); escalate to vision LLM if confidence
#               gate fails. Default. Best speed/quality ratio.
#   fast      → RapidOCR only (~0.25 s) — accept any output. Fastest.
#   vision    → Ollama vision LLM (~10 s) — best 1:1 quality, slow.
#   tesseract → classic tesseract. Legacy fallback.
#   auto      → photos: vision LLM, clean PDF scans: tesseract. Legacy.
#
# Tuning hints:
#   ▸ "I need it really fast, ~95 % is enough"   → OCR_ENGINE=fast
#   ▸ "Receipts with hard Polish diacritics"     → smart + low SMART_*
#   ▸ "Multi-page faktura PDFs, time matters"    → smart + relax SMART_MIN_*
#   ▸ "Must be 100 % 1:1 no matter what"         → OCR_ENGINE=vision
OCR_ENGINE=smart

# ── Line-level smart OCR (exact transcription — default) ─────────────────────
OCR_LINE_LEVEL_ENABLED=true
OCR_LINE_LEVEL_ON_PDF_CROPS=false
OCR_LINE_LEVEL_ESCALATE_BAD_PDF_CROPS=true
PDF_CROP_LINE_ESCALATE_MEAN_CONF=0.85
PDF_CROP_LINE_ESCALATE_MIN_CONF=0.50
PDF_CROP_LINE_ESCALATE_MIN_BOXES=2
OCR_LINE_SKIP_TESSERACT_ABOVE=0.94
OCR_LINE_DISAGREEMENT_THRESHOLD=0.40
OCR_LINE_VERIFICATION_ENABLED=true
OCR_LINE_SUSPICIOUS_THRESHOLD=0.40
# Hands-off default: skip very confident lines and cap per-page Tess checks.
OCR_LINE_VERIFICATION_SKIP_HIGH_CONF_TESSERACT=true
OCR_LINE_TESSERACT_MAX_LINES_PER_PAGE=12
OCR_LINE_DISAGREEMENT_LIGHT=0.22
OCR_LINE_ESCALATE_MEAN_CONF=0.82
OCR_LINE_ESCALATE_MEAN_CONF_LIGHT=0.93
OCR_LINE_ESCALATE_MIN_CONF=0.55
OCR_LINE_ESCALATE_QUALITY_BELOW=0.55
OCR_LINE_MULTI_VARIANT_ON_LIGHT=false
OCR_LINE_VLM_WITHOUT_MULTI_VARIANT=true
OCR_FULLPAGE_VLM_MIN_LINES=3
OCR_CONSENSUS_ENABLED=true
OCR_LINE_CROP_PADDING_PX=8

# Semantic field validation (PESEL, NIP, REGON, VIN, IBAN, dates, invoice numbers)
OCR_SEMANTIC_VALIDATION_ENABLED=true
OCR_SEMANTIC_VALIDATION_ESCALATE=true
OCR_SEMANTIC_VALIDATION_ESCALATE_WARNINGS=false

# Dynamic PDF render DPI (simple receipt / dense / photo-adaptive)
PDF_DPI_ROUTING_ENABLED=true
PDF_DPI_SIMPLE=180
PDF_DPI_DENSE=280
PDF_DPI_DEFAULT=250
PDF_DPI_PHOTO_BASE=220
PDF_DPI_PHOTO_MAX=320
PDF_DPI_PROBE=72
PDF_DPI_ROUTING_PROBE_RENDER=true
PDF_DPI_ROUTING_REGION_PROBE=false
PDF_DPI_DENSE_MIN_PAGES=3
PDF_DPI_DENSE_MIN_BYTES_PER_PAGE=400000
PDF_DPI_DENSE_MIN_AREA_SQ_IN=75
PDF_DPI_SIMPLE_MAX_PAGES=2
PDF_DPI_SIMPLE_MAX_REGIONS=2
PDF_DPI_SIMPLE_MAX_AREA_SQ_IN=90

# Disk-backed OCR cache (SHA1 of image bytes + preprocessing variant)
OCR_CACHE_ENABLED=true
OCR_CACHE_DIR=storage/ocr_cache
OCR_CACHE_MAX_BYTES=2147483648

# Crop-level vision escalation (default; replaces full-page VLM on quality gate)
OCR_PAGE_VISION_ESCALATION_ENABLED=false
OCR_CROP_MERGE_ADJACENT_LINES=true
OCR_CROP_BATCH_SIZE=1

# Legacy page-level gate (only if OCR_LINE_LEVEL_ENABLED=false)
SMART_MIN_MEAN_CONF=0.96
SMART_MIN_LOW_CONF_RATIO=0.07
SMART_WORD_THRESHOLD=0.85
SMART_MIN_WORST_SCORE=0.80
SMART_MIN_LINES=3

# ── GPU: zdjęcia vs duże pliki ─────────────────────────────────────────────────
# Paragony / pojedyncze zdjęcia → tylko GPU 0 (szybka ścieżka, bez segmentacji)
IMAGE_OCR_GPU=0
# PDF / ZIP (duże) → multi-GPU gdy spełnione progi (puste = wszystkie karty)
OCR_BULK_GPU_IDS=0,1
OCR_PAGE_PARALLEL_ENABLED=true
OCR_PAGE_PARALLEL_MIN_PAGES=2
OCR_PARALLEL_ENABLED=true
OCR_PARALLEL_WORKERS=0
OCR_PARALLEL_MIN_PAGES=3
OCR_PARALLEL_MIN_JOBS=4
OCR_PARALLEL_MIN_BYTES=2000000

# ── Fast OCR (RapidOCR / PP-OCRv5 on GPU) ────────────────────────────────────
FAST_USE_CUDA=true
FAST_OCR_VERSION=PPOCRV5         # PPOCRV5 | PPOCRV4
FAST_LANG_TYPE=latin             # latin (PL/EN/ES/...) | eslav | en | ch
FAST_MODEL_TYPE=mobile           # mobile (fast) | server (accurate, slower)
FAST_LINE_Y_TOLERANCE=10
# Universal OCR dedup (geometry + exact text; forms + receipts + PDF + ZIP)
OCR_DEDUP_OVERLAP_IOU=0.40
OCR_DEDUP_MAX_ADJACENT_GAP_PX=5
OCR_DEDUP_MIN_VERTICAL_OVERLAP=0.50
OCR_DEDUP_CONTAINMENT_RATIO=0.82
OCR_DEDUP_MAX_REPEAT_CENTER_PX=180
OCR_DEDUP_MAX_REPEAT_CENTER_RATIO=0.08
OCR_DEDUP_TILE_ECHO_SIMILARITY=0.90
OCR_FILTER_SPURIOUS_FRAGMENTS=true
OCR_NOISE_SHORT_MAX_SCORE=0.84
OCR_NOISE_AMOUNT_MAX_SCORE=0.85

# ── Vision LLM (Ollama) ──────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
# Crop OCR escalation — prefer minicpm-v or qwen2.5vl:7b (not qwen3.6:35b / gemma vision)
VISION_ESCALATION_MODEL=minicpm-v
VISION_MODEL=qwen2.5vl:7b
VISION_MODEL_FAST=minicpm-v
# OCR vision uses fixed sampling in code (temperature=0, top_p=0, repeat_penalty=1).
# These env vars are ignored for OCR; kept for compatibility only.
VISION_TOP_P=0
VISION_REPEAT_PENALTY=1
VISION_MAX_SIDE=1024
VISION_JPEG_QUALITY=90
VISION_NUM_CTX=4096
VISION_NUM_PREDICT=1500
VISION_TIMEOUT=300
VISION_KEEP_ALIVE=60m

# ── Tesseract / PDF ──────────────────────────────────────────────────────────
PDF_DPI=250
PDF_SEGMENT_DOCUMENTS=true
PDF_SMART_ESCALATE=false
PDF_FULLPAGE_FALLBACK_RATIO=0.88
PDF_MIN_REGION_AREA_PCT=0.008
PDF_MIN_REGION_SIDE_PCT=0.03
FAST_TILE_MIN_HEIGHT=1800
# Tesseract verification only (RapidOCR = PP-OCRv5 Latin). Per-line routing: pol+eng vs eng.
OCR_LANG=pol+eng
# Per-job language hint: auto | pl | en
OCR_DOCUMENT_LANGUAGE=auto
OCR_LANG_ROUTING_ENABLED=true
OCR_LANG_TESSERACT_POLISH=pol+eng
OCR_LANG_TESSERACT_ENGLISH=eng
OCR_LANG_POLISH_CHAR_MIN=2
OCR_PSM_DOCUMENT=6
OCR_PSM_RECEIPT=6
OCR_RECEIPT_SCALE=1.5
OCR_RECEIPT_STRIPS=3

# ── Multi-document scan handling (PDF only) ──────────────────────────────────
# Scanner output (SKMBT etc.) often packs 2–4 receipts on a single A4 page,
# some rotated 180°/90°.  When enabled the pipeline:
#   1) finds each separate receipt via OpenCV morphology + gap splitting,
#   2) runs Tesseract OSD to detect orientation,
#   3) rotates each crop upright,
#   4) OCRs each one independently and joins them with a separator.
PDF_SEGMENT_DOCUMENTS=true
PDF_AUTO_ROTATE=true
PDF_MIN_REGION_AREA_PCT=0.01
PDF_MAX_REGIONS_PER_PAGE=20
PDF_OSD_MIN_CONFIDENCE=1.5
PDF_ENHANCE_SCANS=true
PDF_ENHANCE_FAINT_AUTO=true
PDF_MERGE_RESPLIT_PARTS=false
PDF_FULLPAGE_FALLBACK_MAX_REGIONS=1
PDF_FULLPAGE_FALLBACK_MIN_SEGMENTED_CHARS=400
PDF_FULLPAGE_FALLBACK_AGGRESSIVE_RATIO=0.45

# ── ZIP (A2) ─────────────────────────────────────────────────────────────────
ZIP_ORDER_IMAGES_FIRST=true
ZIP_PARALLEL_WORKERS=0
# Pin each ZIP member to a single GPU (round-robin by planned order). Stops
# many single-page PDFs from stacking on GPU 0 in OpenPDF-style archives.
ZIP_PIN_MEMBER_TO_GPU=true
# Cap workers when the archive contains ONLY PDFs (0 = no extra cap).
# Set to 1 if you still hit OOM on dense scans with VRAM-light cards.
ZIP_PDF_MAX_PARALLEL=0
# Fast path: 1-page receipt PDF inside ZIP (OpenPDF) — no segmentation / bulk retry
ZIP_SIMPLE_RECEIPT_ENABLED=true
ZIP_SIMPLE_PDF_DPI=200
# 1–2 page receipt PDFs in ZIP use fast path; 3+ pages use bulk (SKMBT)
ZIP_SIMPLE_RECEIPT_MAX_PAGES=2
# true = render+count regions; use bulk if > ZIP_SIMPLE_RECEIPT_MAX_REGIONS
ZIP_SIMPLE_RECEIPT_PROBE_REGIONS=false
ZIP_SIMPLE_RECEIPT_MAX_REGIONS=2
# zip_simple only: one in-memory retry with force_strong when Rapid finds no boxes
ZIP_SIMPLE_EMPTY_RETRY=true
# ZIP parallel OCR runs in separate processes (spawn); per-file timeout (seconds).
ZIP_MEMBER_TIMEOUT_SEC=600
ZIP_POOL_SHUTDOWN_GRACE_SEC=30
# Recycle ZIP OCR child process after N documents (0 = disabled).
MAX_DOCS_PER_WORKER=200

# ── OOM resilience ───────────────────────────────────────────────────────────
# CUDA/cuBLAS/cuDNN OOM → torch.cuda.empty_cache() + retry once on same GPU.
# Final OOM is recorded as a per-file failure (ZIP) instead of killing the job.
OCR_OOM_RETRY=true
OCR_OOM_RETRY_MAX=1

# Results folders: storage/results/{source_stem}/ (job_id → folder kept in job store / job.json)
# Set false to use storage/results/{uuid}/ only
RESULTS_DIR_USE_SOURCE_NAME=true

# ── Queue (Etap 1: Redis + RQ) ───────────────────────────────────────────────
# JOB_EXECUTION_MODE:
#   auto  -> queue when Redis is reachable, sync fallback otherwise
#   queue -> always enqueue (requires Redis + worker)
#   sync  -> always run OCR in API process
JOB_EXECUTION_MODE=auto
# Legacy flag (backward compatibility). Prefer JOB_EXECUTION_MODE.
USE_BACKGROUND_WORKER=true
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_NAME=default
RQ_JOB_TIMEOUT=86400

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=16106127360

# ── propOS invoice API (sync POST → JSON) ────────────────────────────────────
# POST /api/v1/invoice/extract — single file, response in same connection
INVOICE_MAX_UPLOAD_BYTES=20971520
INVOICE_PROCESS_TIMEOUT_SEC=40
INVOICE_TEXT_MODEL=qwen2.5:32b
INVOICE_LLM_TIMEOUT_SEC=90
INVOICE_LLM_NUM_CTX=16384
INVOICE_MAX_OCR_CHARS=28000
INVOICE_ALLOW_VISION_ESCALATION=false
# Optional Bearer token (empty = no auth on invoice endpoint)
OCR_SERVICE_TOKEN=
